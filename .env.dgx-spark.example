# Copy this file to .env.dgx-spark. The real file is ignored by Git.

# NGC Personal Key used to pull containers and artifacts from nvcr.io.
NGC_API_KEY=

# Local Nemotron 3 Nano NIM settings for the single GB10.
NEMOTRON_NANO_TAG=2.0.5
# Use an exact description returned by list-model-profiles. Do not omit the
# final memory-requirement suffix.
# FP8:   vllm-fp8-tp1-pp1-34.0
# NVFP4: vllm-nvfp4-tp1-pp1-21.0
NEMOTRON_NANO_PROFILE=vllm-fp8-tp1-pp1-34.0
NEMOTRON_NANO_CONTEXT_LENGTH=32768

# Allow up to one hour for first-start model downloads and NIM initialization.
LOCAL_NIM_STARTUP_TIMEOUT=3600

# NVIDIA's OCR source is compiled locally because its prebuilt NIM is x86-only.
# DGX Spark GB10 uses CUDA compute capability 12.1.
NEMOTRON_OCR_CUDA_ARCH_LIST=12.1+PTX

# Pin the Blueprint container release used by the cloned source tree.
TAG=2.6.0

# Keep every Compose file in one shared Docker project and network.
COMPOSE_PROJECT_NAME=nvidia-rag-dgx-spark

# Set true when this account must use sudo to reach the Docker daemon. The
# wrapper elevates Docker only, keeping project files owned by the normal user.
DGX_SPARK_DOCKER_SUDO=false

# Begin with the standard retrieve-then-generate pipeline. Agentic mode adds
# extra local LLM requests and is better enabled after the baseline is measured.
ENABLE_AGENTIC_RAG=false

# Keep reasoning enabled. The DGX Spark parser treats Nemotron 3 Nano content
# before its closing </think> marker as structured reasoning rather than answer text.
LLM_ENABLE_THINKING=true
