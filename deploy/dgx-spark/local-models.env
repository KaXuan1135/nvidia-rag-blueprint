# Fully local DGX Spark model endpoints.
export NVIDIA_API_KEY=local

export APP_LLM_SERVERURL=nim-llm:8000
export APP_LLM_MODELNAME=nvidia/nemotron-3-nano
export APP_QUERYREWRITER_SERVERURL=nim-llm:8000
export APP_QUERYREWRITER_MODELNAME=nvidia/nemotron-3-nano
export APP_FILTEREXPRESSIONGENERATOR_SERVERURL=nim-llm:8000
export APP_FILTEREXPRESSIONGENERATOR_MODELNAME=nvidia/nemotron-3-nano
export SUMMARY_LLM_SERVERURL=nim-llm:8000
export SUMMARY_LLM=nvidia/nemotron-3-nano
export REFLECTION_LLM_SERVERURL=nim-llm:8000
export REFLECTION_LLM=nvidia/nemotron-3-nano

export APP_EMBEDDINGS_SERVERURL=nemotron-vlm-embedding-ms:8000/v1
export APP_EMBEDDINGS_MODELNAME=nvidia/llama-nemotron-embed-vl-1b-v2
export APP_EMBEDDINGS_DIMENSIONS=2048
export APP_RANKING_SERVERURL=nemotron-ranking-ms:8000
export APP_RANKING_MODELNAME=nvidia/llama-nemotron-rerank-1b-v2

export OCR_HTTP_ENDPOINT=http://nemotron-ocr:8000/v1/infer
export OCR_INFER_PROTOCOL=http
export OCR_MODEL_NAME=scene_text_ensemble
export YOLOX_GRPC_ENDPOINT=page-elements:8001
export YOLOX_INFER_PROTOCOL=http
export YOLOX_GRAPHIC_ELEMENTS_GRPC_ENDPOINT=graphic-elements:8001
export YOLOX_GRAPHIC_ELEMENTS_INFER_PROTOCOL=http
export YOLOX_TABLE_STRUCTURE_GRPC_ENDPOINT=table-structure:8001
export YOLOX_TABLE_STRUCTURE_INFER_PROTOCOL=http

export LLM_ENABLE_THINKING=true
export LLM_REASONING_BUDGET=${LLM_REASONING_BUDGET:-256}
export LLM_LOW_EFFORT=true
export FILTER_THINK_TOKENS=true
